NODE_ENV=development
PORT=5000
LOG_LEVEL=info
SERVER_ID=local-dev

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/amazon_like
MONGODB_ENABLE_LOCAL_FALLBACK=true
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/amazon_like

# Auth and cookies
JWT_ACCESS_SECRET=generate_64_plus_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_TTL_MINUTES=15
JWT_ACCESS_COOKIE_MAX_AGE_MS=900000
JWT_REFRESH_SECRET=generate_64_plus_char_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_TTL_DAYS=7
JWT_SECRET=generate_64_plus_char_legacy_secret
CSRF_SECRET=generate_64_plus_char_csrf_secret
CSRF_COOKIE_MAX_AGE_MS=7200000
AUTH_COOKIE_SAMESITE=lax
TRACKING_JWT_SECRET=generate_64_plus_char_tracking_secret
STAFF_JWT_ACCESS_SECRET=generate_64_plus_char_staff_access_secret
STAFF_JWT_REFRESH_SECRET=generate_64_plus_char_staff_refresh_secret
STAFF_JWT_ACCESS_EXPIRES_IN=15m
STAFF_JWT_REFRESH_EXPIRES_IN=30d
STAFF_JWT_REFRESH_TTL_DAYS=30
ENCRYPTION_MASTER_KEY=generate_32_plus_char_encryption_key
DATA_ENCRYPTION_KEY=generate_32_plus_char_data_encryption_key

# CORS and app URLs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
VENDOR_URL=http://localhost:5173
INFLUENCER_URL=http://localhost:5173
INTERNAL_SERVICE_ORIGINS=

# Rate limiting and logging
AUTH_RATE_LIMIT_MAX=60
AUTH_LOGIN_RATE_LIMIT_MAX=60
AUTH_REFRESH_RATE_LIMIT_MAX=120
PASSWORD_RESET_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=5000
PUBLIC_API_RATE_LIMIT_MAX=10000
SLOW_API_LOG_MS=750

# Uploads
MAX_FILE_SIZE_BYTES=5242880
MAX_VIDEO_FILE_SIZE_BYTES=52428800
REEL_MAX_UPLOAD_BYTES=104857600

# Cloudinary. Leave blank to use local upload fallback.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_MAX_AGE_SECONDS=600
RAZORPAY_PAYOUT_SOURCE_ACCOUNT=
RAZORPAY_ACCOUNT_ID=
RAZORPAY_DEFAULT_CURRENCY=INR
RAZORPAY_VERIFY_ON_STARTUP=false
RAZORPAY_STARTUP_CHECK_AMOUNT=100
RAZORPAY_STARTUP_CHECK_TIMEOUT_MS=8000
RAZORPAY_HEALTH_ORDER_AMOUNT=100
RAZORPAY_HEALTH_TIMEOUT_MS=8000
RAZORPAY_PAYMENT_FETCH_TIMEOUT_MS=8000
RAZORPAY_TEST_AMOUNT=100
RAZORPAY_TEST_CURRENCY=INR
CAMPAIGN_RAZORPAY_TIMEOUT_MS=6500
CAMPAIGN_RAZORPAY_RETRY_DELAY_MS=300000

# Shiprocket
LOGISTICS_PROVIDER=SHIPROCKET
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=

# Email and OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=GRM Platform
SMTP_FROM_EMAIL=
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# SMS and WhatsApp
SMS_PROVIDER=
TWILIO_SMS_ACCOUNT_SID=
TWILIO_SMS_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_ORDER_SHIPPED_CONTENT_SID=

# Admin bootstrap
ALLOW_ADMIN_REGISTRATION=false
ALLOW_STANDALONE_ESCROW_RELEASES=false
BOOTSTRAP_EXECUTED_BY=cli
ADMIN_NAME=Platform Admin
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Platform defaults
DEFAULT_CURRENCY=INR
PLATFORM_STORE_EMAIL=platform-store@grm.local
PLATFORM_STORE_PHONE=9000000000
PLATFORM_STORE_PASSWORD=PlatformStore123

# Invoice and order support
INVOICE_COMPANY_NAME=GRM Platform
INVOICE_COMPANY_WEBSITE=http://localhost:5173
INVOICE_TAX_LABEL=GSTIN
INVOICE_TAX_ID=
ORDER_SUPPORT_EMAIL=support@grm.local
ORDER_SUPPORT_PHONE=9000000000

# Jobs and queue
SETTLEMENT_SCHEDULER_MODE=auto
SETTLEMENT_JOB_SCHEDULE=*/10 * * * * *
SETTLEMENT_BATCH_SIZE=50
SETTLEMENT_MAX_RETRIES=3
SETTLEMENT_ENABLE_CRON_FALLBACK=true
PAYOUT_DELAY_DAYS=0
MIN_PAYOUT_REQUEST_AMOUNT=500
PAYMENT_MAINTENANCE_CRON=*/15 * * * *
AFFILIATE_LINK_EXPIRY_SCHEDULE=0 * * * *
INFLUENCER_SETTLEMENT_SCHEDULE=15 2 * * *
INFLUENCER_TRACKING_CLEANUP_SCHEDULE=0 * * * *
INFLUENCER_METRICS_SCHEDULE=30 2 * * *
INFLUENCER_SUBSCRIPTION_EXPIRY_SCHEDULE=5 0 * * *
CAMPAIGN_FINANCE_SYNC_SCHEDULE=10 * * * *
ANALYTICS_REBUILD_SCHEDULE=0 * * * *
ANALYTICS_VALIDATION_SCHEDULE=*/30 * * * *
REVENUE_RECONCILIATION_SCHEDULE=20 1 * * *
COMMISSION_RECONCILIATION_SCHEDULE=35 1 * * *
ESCROW_RECONCILIATION_SCHEDULE=50 1 * * *
ESCROW_REFUND_SCAN_SCHEDULE=45 1 * * *
CAMPAIGN_SCHEDULING_SCAN_SCHEDULE=0 * * * *
CAMPAIGN_FINANCE_SYNC_CONCURRENCY=5
ESCROW_REFUND_PENDING_SLA_HOURS=72
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DISABLED=true

# Cache and operation limits
CART_OPERATION_TIMEOUT_MS=4500
COMPANY_BRANDING_CACHE_MS=15000
VENDOR_STOREFRONT_CACHE_TTL_MS=60000
CAMPAIGN_SCHEDULING_SETTINGS_CACHE_MS=60000
INFLUENCER_COMMERCE_CONFIG_CACHE_MS=60000

# Influencer and affiliate defaults
INFLUENCER_DEFAULT_COMMISSION_PERCENT=10
INFLUENCER_DEFAULT_COMMISSION_MODEL=Per Sale
INFLUENCER_DEFAULT_COMMISSION_RATE=10
INFLUENCER_MAX_COMMISSION_RATE=50
INFLUENCER_MIN_PAYOUT_THRESHOLD=500
INFLUENCER_PAYOUT_SCHEDULE=Monthly
INFLUENCER_HOLD_DAYS=7
INFLUENCER_TRACKING_TTL_HOURS=720
AFFILIATE_ATTRIBUTION_WINDOW_HOURS=720
AFFILIATE_ATTRIBUTION_WINDOW_DAYS=30

# Tracking security defaults
TRACKING_SECURITY_RETENTION_DAYS=30
TRACKING_REEL_VIEW_WINDOW_MS=86400000
TRACKING_REEL_VIEW_VISITOR_MAX=5
TRACKING_REEL_VIEW_DEDUP_MS=1800000
TRACKING_PRODUCT_CLICK_WINDOW_MS=3600000
TRACKING_PRODUCT_CLICK_VISITOR_MAX=10
TRACKING_PRODUCT_CLICK_DEDUP_MS=300000
TRACKING_STORE_VISIT_WINDOW_MS=1800000
TRACKING_STORE_VISIT_VISITOR_MAX=3
TRACKING_STORE_VISIT_DEDUP_MS=600000
TRACKING_SHARE_WINDOW_MS=3600000
TRACKING_SHARE_VISITOR_MAX=20
TRACKING_SHARE_DEDUP_MS=60000
TRACKING_LIKE_WINDOW_MS=3600000
TRACKING_LIKE_VISITOR_MAX=100
TRACKING_LIKE_DEDUP_MS=5000
TRACKING_COMMENT_WINDOW_MS=3600000
TRACKING_COMMENT_VISITOR_MAX=50
TRACKING_COMMENT_DEDUP_MS=10000
TRACKING_EVENT_WINDOW_MS=3600000
TRACKING_EVENT_VISITOR_MAX=120
TRACKING_EVENT_DEDUP_MS=300000
TRACKING_FRAUD_BLOCK_SCORE=85

# Social integrations
META_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
