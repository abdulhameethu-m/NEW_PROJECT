{
  "expo": {
    "name": "UChooseMe",
    "slug": "abdul-hameethu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "customerapp",
      "uchooz"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.abdulhameethusteam.abdulhameethu",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow UChooseMe to access your camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow UChooseMe to access your photos to select a profile picture."
      },
      "associatedDomains": [
        "applinks:uchooseme.com",
        "applinks:*.uchooseme.com"
      ]
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abdulhameethusteam.abdulhameethu",
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "uchooseme.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "uchooseme.com",
              "pathPrefix": "/reels"
            },
            {
              "scheme": "https",
              "host": "uchooseme.com",
              "pathPrefix": "/orders"
            },
            {
              "scheme": "https",
              "host": "uchooseme.com",
              "pathPrefix": "/stores"
            },
            {
              "scheme": "https",
              "host": "uchooseme.com",
              "pathPrefix": "/vendor"
            },
            {
              "scheme": "https",
              "host": "uchooseme.com",
              "pathPrefix": "/search"
            },
            {
              "scheme": "https",
              "host": "*.uchooseme.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "*.uchooseme.com",
              "pathPrefix": "/reels"
            },
            {
              "scheme": "https",
              "host": "*.uchooseme.com",
              "pathPrefix": "/orders"
            },
            {
              "scheme": "https",
              "host": "*.uchooseme.com",
              "pathPrefix": "/stores"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@preeternal/react-native-cookie-manager",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow UChooseMe to access your photos to select a profile picture.",
          "cameraPermission": "Allow UChooseMe to access your camera to take a profile photo."
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4f46e5"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fe41d304-3aeb-4a6e-8361-6d64c3466a8b"
      }
    }
  }
}
